# KinTane top-level configuration.

source "arch.kcfg"

# --- derived build settings -------------------------------------------------
# Readonly and defaulted per architecture, so there is one place that knows which
# target specification and linker script an architecture needs.

config TARGET
    string
    readonly
    default "x86_64-kintane" if ARCH_X86_64
    default "aarch64-kintane" if ARCH_AARCH64
    default "i686-kintane" if ARCH_I686
    default ""
    help
        Name of the target specification under targets/.

config LINKER_SCRIPT
    string
    readonly
    default "arch/x86_64/link.ld" if ARCH_X86_64
    default "arch/aarch64/link.ld" if ARCH_AARCH64
    default "arch/i686/link.ld" if ARCH_I686
    default ""

# --- memory model -----------------------------------------------------------

choice MM_MODEL
    prompt "Memory model"
    default MM_PAGED if ARCH_HAS_MMU
    default MM_FLAT

    config MM_PAGED
        bool "Paged virtual memory"
        depends on ARCH_HAS_MMU

    config MM_FLAT
        bool "Flat physical memory"
        help
            No address translation. Required on targets without an MMU;
            selectable on MMU targets for minimal-overhead builds.
endchoice

# --- kernel ------------------------------------------------------------------

config SMP
    bool "Symmetric multiprocessing"
    depends on ARCH_HAS_SMP
    default y if ARCH_HAS_SMP
    help
        Support more than one CPU. Requires an architecture that implements
        the HasSmp capability.

config NR_CPUS
    int "Maximum number of CPUs"
    depends on SMP
    range 2 4096
    default 8

config EARLY_CONSOLE
    bool "Early console"
    default y
    help
        A console available before the device framework exists. On x86 this is
        the 16550 UART at the legacy COM1 address.

config DEBUG_BUILD
    bool "Debug build"
    default n
    help
        Lower optimisation, overflow checks, poisoned allocations, and
        lock-order checking. Separate from debug symbols, which are always
        produced and always shipped separately.

config KALLOC_FAULT_INJECT
    bool "Allocation fault injection"
    default n
    help
        Let the kernel heap fail chosen allocations on purpose, under a
        deterministic policy: the Nth request, every request from the Nth,
        or one in N from a seeded generator. This is how the error branches
        of allocating code are made to run, since on a machine with memory
        to spare they otherwise never do.

        Off, every injection point is a constant false the compiler removes.
        The heap's own host tests always have it, whatever this says. Never
        enable it in anything that ships: a policy left armed fails real
        allocations.

config DEBUG_LOCKDEP
    bool "Lock-order checking"
    default y if DEBUG_BUILD
    help
        Every lock with a class reports acquisitions and releases to a
        validator that records the order classes are taken in and reports an
        inversion the first time both orders have been seen, without needing
        the deadlock to happen. Recursion stops the CPU. When off, locks carry
        no class and pay nothing. See kernel/sync/src/lockdep.rs.

config LOCKDEP_ABBA_TEST
    bool "Take two locks in opposite orders on purpose"
    depends on DEBUG_LOCKDEP
    default n
    help
        After the scheduler checks, two kernel threads take two locks in
        opposite orders, one after the other, so nothing deadlocks. The boot
        verdict then passes only if lock-order checking reported exactly that
        inversion. Without this, a checker that recorded nothing would pass
        every boot. A test mode, never a production setting: the kernel it
        builds has a lock-order bug on purpose.

config QEMU_EXIT
    bool "Guest-initiated emulator exit"
    depends on ARCH_X86_64 || ARCH_I686 || ARCH_AARCH64
    default n
    help
        Let the guest terminate the emulator with a status. This is the result
        channel the test protocol uses, so that a verdict is an exit code and
        never a string scraped from console output; see docs/testing.md.

        How it is done is per-architecture: isa-debug-exit on x86, semihosting
        on AArch64. Neither belongs in a production image. The x86 form writes
        to an I/O port that is merely inert on real hardware, but the AArch64
        form executes HLT #0xF000, which is UNDEFINED without a debugger
        attached — so this must be off in anything that ships.

config BOOT_KINBOOT
    bool "Boot through kinboot-efi"
    depends on ARCH_X86_64
    default n
    help
        Start the kernel from UEFI firmware through KinTane's own loader,
        kinboot-efi, which hands over the boot protocol's structure instead
        of a multiboot one. The build produces a disk image with an EFI
        system partition holding the loader and the kernel, and QEMU boots
        it under OVMF rather than with -kernel. See docs/bootloader.md.

        Off, the image is the multiboot kernel QEMU loads directly, which is
        the faster path for everyday development.

config IMAGE_FORMAT
    string
    readonly
    default "efi-esp" if BOOT_KINBOOT
    default "multiboot-elf32" if ARCH_X86_64
    default "elf"
    # i686 links as ELF32 already, so the multiboot container needs no rewrite.
    help
        How the linked image is packaged for the platform's loader.
        QEMU's multiboot loader refuses an ELF64 container, so on x86_64 the
        image is rewritten to ELF32 after linking. The 64-bit code is untouched
        and the ELF64 is kept as the debug artifact. `efi-esp` is a disk image
        whose EFI system partition holds kinboot-efi and the stripped ELF64.

config KINBOOT_BIOS
    bool "Boot from a BIOS disk through kinboot-bios"
    depends on ARCH_X86_64 || ARCH_I686
    default n
    help
        Also build the BIOS loader and write build/<target>/out/kinboot-bios.img:
        an MBR, stage 2 and the packaged kernel image. `kbuild run` and
        `kbuild test --target` then boot that disk through the machine's
        firmware, with no -kernel, so every boot test exercises the loader.

        The loader hands over as a Multiboot 1 loader, which both x86 kernels
        already accept. See docs/bootloader.md. The BIOS path has no root of
        trust, and this option offers no security guarantee.

config MOCK_ARCH
    bool "Mock architectures for host testing"
    default n
    help
        Compile the MockArch family in hal. These implement the capability
        traits in software so that subsystems can be tested on the host
        against several different hardware profiles. Never enabled in a
        kernel image; `kbuild test --host` turns it on.

config INKERNEL_TESTS
    bool "In-kernel test suite"
    depends on QEMU_EXIT
    default n
    help
        Compile and run tests that must execute on the real architecture:
        atomics, interrupt masking, exception entry, and the frame allocator
        over the machine's actual memory map. Host tests against the mock
        architectures cover everything that does not need real hardware;
        this covers what is left.

        Requires a result channel, since the verdict is the guest's exit
        status rather than console output a harness would have to scrape.

config STACK_GUARD_TEST
    bool "Overflow the boot stack on purpose"
    depends on QEMU_EXIT
    default n
    help
        After bring-up, recurse until the boot stack reaches its guard page,
        instead of running anything else. The run passes only if the fault
        that ends it is on the guard page: the exception path checks the
        faulting address and exits through the emulator's result channel.
        Any other fault, or none, is a failure.

        A test mode, never a production setting. It exists because "the guard
        page is unmapped" is a property of a table, and "an overflow is caught
        and reported" is a property of the running machine. Only the second
        is worth having; see docs/testing.md.

config THREAD_STACK_GUARD_TEST
    bool "Overflow a kernel thread's stack on purpose"
    depends on QEMU_EXIT
    default n
    help
        After bring-up, start a kernel thread on a stack from the guarded
        thread-stack array and recurse until it reaches that stack's guard
        page. The run passes only if the fault that ends it is on that guard:
        a boot-stack guard hit, or a thread stack quietly overflowing into
        the one below it, is a failure.

        A test mode, never a production setting; see STACK_GUARD_TEST.

config NULL_DEREF_TEST
    bool "Read through a null pointer on purpose"
    depends on QEMU_EXIT
    default n
    help
        After bring-up, read address zero. Page 0 is never mapped in the
        kernel's address space, so the read must fault, and the run passes
        only if the fault is reported as a null dereference.

        A test mode, never a production setting; see STACK_GUARD_TEST.

config STRESS_TEST
    bool "Run the stress workload after bring-up"
    depends on QEMU_EXIT
    select KALLOC_FAULT_INJECT
    default n
    help
        After a clean bring-up, hand the CPU to the scheduler and run mixed
        workloads for STRESS_SECONDS of guest time: heap churn under seeded
        fault injection, channel ping-pong moving handles, sleeps to random
        deadlines, demand paging with copy-on-write, and buddy page churn.
        An auditor thread stops the workloads at checkpoints every second,
        checks the books of each subsystem and that every workload made
        progress, and prints a heartbeat line `kbuild stress` watches. Any
        failed audit ends the run with a failure; the end of the time is a
        final audit and a success. See docs/testing.md.

        A test mode, never a production setting: it injects allocation
        failures into the kernel heap on purpose.

config STRESS_SECONDS
    int "Stress run length (seconds of guest time)"
    depends on STRESS_TEST
    range 1 604800
    default 60

config STRESS_SEED
    int "Stress run seed"
    depends on STRESS_TEST
    range 1 2147483647
    default 1
    help
        Seeds the heap's fault injector and every workload's random choices,
        so a failing run can be replayed with the same sequence of decisions.
        Thread interleaving still depends on timing, which no seed controls.

# Crash on purpose once boot has finished, from a known nested function, so the
# crash report can be checked end to end: the kernel prints raw return addresses,
# and `kbuild symbolize` must name the function. A backtrace is only ever needed
# when something has already gone wrong, which is exactly when an untested one
# turns out not to work.
choice CRASH_TEST
    prompt "Deliberate crash after boot"
    default CRASH_NONE

    config CRASH_NONE
        bool "No deliberate crash"

    config CRASH_PANIC
        bool "Panic from a nested function"

    config CRASH_FAULT
        bool "Undefined instruction from a nested function"
endchoice

config FRAME_BITMAP_KIB
    int "Boot-time frame bitmap reserve (KiB)"
    range 4 4096
    default 32
    help
        Static reserve the boot path builds its frame allocator bitmap in.
        Two bits per frame of usable span, so 32 KiB covers about 512 MiB at
        a 4 KiB page. A machine with more memory than this reports the
        shortfall and skips the report rather than truncating the pool.

        This is a bootstrap shortcut. The bitmap should be carved out of the
        memory it describes and this symbol should disappear; until then a
        preset that boots a large machine must raise it.

config QEMU_MEMORY_MB
    int "Guest memory under QEMU (MiB)"
    depends on QEMU_EXIT
    range 8 65536
    default 128

config QEMU_CPU
    string "CPU model under QEMU"
    depends on QEMU_EXIT
    default "max"
    help
        The i686 target deliberately runs on QEMU's default 32-bit CPU in
        its main preset, because it exists to serve legacy machines and
        testing it only on a modern core would defeat that. A second preset
        raises it, so both are covered.
