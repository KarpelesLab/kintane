# KinTane top-level configuration.

source "arch.kcfg"

# --- derived build settings -------------------------------------------------
# Readonly and defaulted per architecture, so there is one place that knows which
# target specification and linker script an architecture needs.

config TARGET
    string
    readonly
    default "x86_64-kintane" if ARCH_X86_64
    default "aarch64-kintane" if ARCH_AARCH64
    default "i686-kintane" if ARCH_I686
    default "riscv32i-kintane" if RISCV32_NO_ATOMICS
    default "riscv32-kintane" if ARCH_RISCV32
    default "armv7m-kintane" if ARCH_ARMV7M
    default ""
    help
        Name of the target specification under targets/.

config LINKER_SCRIPT
    string
    readonly
    default "arch/x86_64/link.ld" if ARCH_X86_64
    default "arch/aarch64/link.ld" if ARCH_AARCH64
    default "arch/i686/link.ld" if ARCH_I686
    default "arch/riscv32/link.ld" if ARCH_RISCV32
    default "arch/armv7m/link.ld" if ARCH_ARMV7M
    default ""

# --- memory model -----------------------------------------------------------

choice MM_MODEL
    prompt "Memory model"
    default MM_PAGED if ARCH_HAS_MMU
    default MM_FLAT

    config MM_PAGED
        bool "Paged virtual memory"
        depends on ARCH_HAS_MMU

    config MM_FLAT
        bool "Flat physical memory"
        help
            No address translation. Required on targets without an MMU;
            selectable on MMU targets for minimal-overhead builds.
endchoice

# --- memory the image reserves -----------------------------------------------
#
# Sizes a linker script reserves, rather than anything the allocator hands out. They are
# the difference between an image that fits a microcontroller and one that does not: on
# ARMv7-M these four sections were 90% of the RAM the image claimed. kbuild writes every
# int symbol into `sizes.ld` for a script to INCLUDE; see docs/build-system.md.

config BOOT_STACK_KIB
    int "Size of the boot stack (KiB)"
    range 1 256
    default 16
    help
        The stack the first thread of execution runs on, with a guard below it.

config HANDLER_STACK_KIB
    int "Size of the exception stack (KiB)"
    range 1 64
    default 8
    help
        Ports that run handlers on a stack of their own — ARMv7-M's main stack —
        size it with this. Nothing is below it but .bss, so an overflow of this
        one is not caught; handlers here are small and do not nest.

# --- interrupt controller drivers --------------------------------------------
#
# Which drivers an aarch64 image carries. Both, the default, is the configuration
# `docs/portability.md` argues for: one image drives a GICv2 on one board and a GICv3 on
# another, decided by the device tree. A board-specific image can leave one out, and then
# the question the vtable answers has only one answer, which is what IRQCHIP_STATIC is.

config GIC_V2
    bool "Arm GICv2 driver"
    depends on ARCH_AARCH64
    default y if ARCH_AARCH64
    help
        Bind `arm,cortex-a15-gic` and `arm,gic-400` controllers. Leaving it out
        of an image that meets one is not a fallback but a failed boot: the
        controller node binds nothing and discovery says so.

config GIC_V3
    bool "Arm GICv3 driver"
    depends on ARCH_AARCH64
    default y if ARCH_AARCH64
    help
        Bind `arm,gic-v3` controllers.

config IRQCHIP_STATIC
    bool "Dispatch interrupts without a vtable"
    depends on ARCH_AARCH64 && !(GIC_V2 && GIC_V3)
    default y if ARCH_AARCH64
    help
        With exactly one interrupt-controller driver in the image, the platform
        provider instantiates the architecture's dispatch loop for that driver's
        own type and exports it as `kintane_irq_dispatch`; the IRQ vector calls
        it directly. Every claim, ID and EOI on the interrupt path is then a
        direct, inlinable call instead of a vtable call.

        It cannot be selected while two drivers are enabled, because then only
        the running machine knows which one answers. Other ports do not have the
        symbol: ARMv7-M's NVIC is part of the architecture and was always a
        direct call, and x86 carries both the 8259A and the APIC.

# --- kernel ------------------------------------------------------------------

config SMP
    bool "Symmetric multiprocessing"
    depends on ARCH_HAS_SMP
    default y if ARCH_HAS_SMP
    help
        Support more than one CPU. Requires an architecture that implements
        the HasSmp capability.

config NR_CPUS
    int "Maximum number of CPUs"
    depends on SMP
    range 2 4096
    default 8

config KERNEL_THREAD_SLOTS
    int "Guarded stack slots for kernel threads"
    range 2 256
    default 14 if STRESS_TEST && DRIVER_ISOLATION
    default 13 if STRESS_TEST
    default 8
    help
        How many kernel threads may hold a guarded stack at once, not
        counting the one each secondary CPU takes to come up on. The
        scheduler's own check holds four and the stress run four more, so
        eight is the floor for a test build; a build that asks for fewer
        than its threads need fails to compile, in kernel/main/src/preempt.rs.

        The port's linker script reserves this many slots plus one per
        secondary CPU, so the array grows with NR_CPUS without anyone
        editing a linker script. See docs/architecture.md, "Thread stacks".

config THREAD_STACK_KIB
    int "Bytes in a kernel thread's stack slot (KiB)"
    range 1 1024
    default 32
    help
        One slot: the guard at its bottom and the stack above it. A power
        of two, which hal::StackArray requires so a faulting address maps
        to its slot with a shift. Every slot costs this much RAM whether a
        thread uses it or not, which is what makes it worth turning down on
        a machine with kilobytes rather than gigabytes.

config USERSPACE
    bool "Native userspace"
    depends on (ARCH_X86_64 || ARCH_AARCH64) && MM_PAGED
    default y
    help
        Unprivileged processes: per-process address spaces, the native
        system call ABI (lib/abi), and the first user program (user/init),
        which the kernel embeds and runs at boot to check the whole path.

        Requires a port that implements hal::HasUserMode, which today is
        x86_64 and aarch64, and a paged memory model: a process's address
        space is its own page tables. A kernel without it is tasks in the
        kernel, which is what docs/userspace-abi.md says a small build is.

config EARLY_CONSOLE
    bool "Early console"
    default y
    help
        A console available before the device framework exists. On x86 this is
        the 16550 UART at the legacy COM1 address.

config DEBUG_BUILD
    bool "Debug build"
    default n
    help
        Lower optimisation, overflow checks, poisoned allocations, and
        lock-order checking. Separate from debug symbols, which are always
        produced and always shipped separately.

config OPTIMIZE_FOR_SIZE
    bool "Optimise for size"
    default n
    help
        Compile the kernel at opt-level "z" instead of 1 (debug) or 2. For
        targets where the image's size is the constraint that matters: the
        roadmap's ARMv7-M image has 64 KiB of flash to fit in. Takes
        precedence over DEBUG_BUILD's optimisation level, not over its
        checks.

config KALLOC_FAULT_INJECT
    bool "Allocation fault injection"
    default n
    help
        Let the kernel heap fail chosen allocations on purpose, under a
        deterministic policy: the Nth request, every request from the Nth,
        or one in N from a seeded generator. This is how the error branches
        of allocating code are made to run, since on a machine with memory
        to spare they otherwise never do.

        Off, every injection point is a constant false the compiler removes.
        The heap's own host tests always have it, whatever this says. Never
        enable it in anything that ships: a policy left armed fails real
        allocations.

config DEBUG_LOCKDEP
    bool "Lock-order checking"
    default y if DEBUG_BUILD
    help
        Every lock with a class reports acquisitions and releases to a
        validator that records the order classes are taken in and reports an
        inversion the first time both orders have been seen, without needing
        the deadlock to happen. Recursion stops the CPU. When off, locks carry
        no class and pay nothing. See kernel/sync/src/lockdep.rs.

config LOCKDEP_ABBA_TEST
    bool "Take two locks in opposite orders on purpose"
    depends on DEBUG_LOCKDEP
    default n
    help
        After the scheduler checks, two kernel threads take two locks in
        opposite orders, one after the other, so nothing deadlocks. The boot
        verdict then passes only if lock-order checking reported exactly that
        inversion. Without this, a checker that recorded nothing would pass
        every boot. A test mode, never a production setting: the kernel it
        builds has a lock-order bug on purpose.

config QEMU_EXIT
    bool "Guest-initiated emulator exit"
    depends on ARCH_X86_64 || ARCH_I686 || ARCH_AARCH64 || ARCH_RISCV32 || ARCH_ARMV7M
    default n
    help
        Let the guest terminate the emulator with a status. This is the result
        channel the test protocol uses, so that a verdict is an exit code and
        never a string scraped from console output; see docs/testing.md.

        How it is done is per-architecture: isa-debug-exit on x86, semihosting
        on AArch64 and ARMv7-M, the sifive_test finisher on riscv32. None belongs in a
        production image. The x86 form writes to an I/O port that is merely
        inert on real hardware, but the AArch64 form executes HLT #0xF000,
        which is UNDEFINED without a debugger attached (ARMv7-M's BKPT #0xAB
        escalates to a HardFault on a board with no debugger), and the riscv32 form
        stores to a fixed physical address — so this must be off in anything
        that ships.

config BOOT_KINBOOT
    bool
    readonly
    help
        The kernel is started by a KinTane loader and reads the boot
        protocol's own structure rather than a multiboot one. Selected by
        KINBOOT_EFI and KINBOOT_BIOS; off, the image is the multiboot kernel
        QEMU loads directly, which is the faster path for everyday
        development.

config KINBOOT_EFI
    bool "Boot through kinboot-efi"
    depends on ARCH_X86_64
    select BOOT_KINBOOT
    default n
    help
        Start the kernel from UEFI firmware through KinTane's own loader,
        kinboot-efi, which hands over the boot protocol's structure. The
        build produces a disk image with an EFI system partition holding the
        loader, its boot entries and the kernel, and QEMU boots it under
        OVMF rather than with -kernel. See docs/bootloader.md.

config KINBOOT_STUB
    bool "Boot the kernel as its own UEFI application (the EFI stub)"
    depends on ARCH_X86_64 && !KINBOOT_EFI
    select BOOT_KINBOOT
    default n
    help
        Emit the kernel as a PE/COFF EFI application with the handover in
        front of it, so firmware starts one file and there is no loader
        beside it on the partition. kbuild adds the kernel and the command
        line to that image as sections after both are linked; see
        docs/bootloader.md.

        Not with KINBOOT_EFI: a build produces one bootable arrangement, and
        the two answer the same question differently.

config IMAGE_FORMAT
    string
    readonly
    default "efi-esp" if KINBOOT_EFI
    default "efi-stub" if KINBOOT_STUB
    default "multiboot-elf32" if ARCH_X86_64
    default "elf"
    # i686 links as ELF32 already, so the multiboot container needs no rewrite.
    help
        How the linked image is packaged for the platform's loader.
        QEMU's multiboot loader refuses an ELF64 container, so on x86_64 the
        image is rewritten to ELF32 after linking. The 64-bit code is untouched
        and the ELF64 is kept as the debug artifact. `efi-esp` is a disk image
        whose EFI system partition holds kinboot-efi and the stripped ELF64;
        `efi-stub` is one whose partition holds a single application, the
        kernel carried inside the stub.

config KINBOOT_BIOS
    bool "Boot from a BIOS disk through kinboot-bios"
    depends on ARCH_X86_64 || ARCH_I686
    select BOOT_KINBOOT
    default n
    help
        Also build the BIOS loader and write build/<target>/out/kinboot-bios.img:
        an MBR, stage 2, the boot entries and the packaged kernel image.
        `kbuild run` and `kbuild test --target` then boot that disk through
        the machine's firmware, with no -kernel, so every boot test exercises
        the loader.

        The loader hands over the boot protocol's structure through the
        kernel's 32-bit entry. See docs/bootloader.md. The BIOS path has no
        root of trust, and this option offers no security guarantee.

# --- boot entries and the command line --------------------------------------
# One set of settings for every boot path. A KinTane loader writes them into the
# boot entries on its medium; `-kernel` boots get the same line through -append.
# See docs/bootloader.md#boot-options.

config CMDLINE
    string "Kernel command line"
    default "kintane.canary=cmdline-intact" if QEMU_EXIT
    default ""
    help
        Arguments every boot entry passes to the kernel, after the entry's
        own `mode=`. Test builds default to a canary the kernel's boot check
        compares word for word, so a line lost or mangled anywhere between
        the build and the kernel fails the boot.

# The mode of the entry a loader boots when nobody chooses, and the `mode=` a
# `-kernel` boot is given. The modes are defined in docs/bootloader.md#modes.
choice BOOT_MODE
    prompt "Default boot mode"
    default BOOT_MODE_NORMAL

    config BOOT_MODE_NORMAL
        bool "normal"

    config BOOT_MODE_SAFE
        bool "safe"

    config BOOT_MODE_RECOVERY
        bool "recovery"
endchoice

config BOOT_MENU_TIMEOUT
    int "Seconds the boot menu waits"
    range 0 600
    default 0 if QEMU_EXIT
    default 5
    help
        How long a KinTane loader shows its entries before booting the
        default. Test builds use 0, which still prints the menu but never
        waits on it: a harness that has to sit through a countdown is a slow
        harness.

config BOOT_ARGS_CHECK
    bool "Require the command line the build wrote"
    depends on QEMU_EXIT && !BOOT_COUNTER_TEST
    default y if QEMU_EXIT
    help
        Fail the boot unless the kernel received `mode=` BOOT_EXPECT_MODE
        followed by exactly the words of CMDLINE. A test setting: a real
        machine's boot entries are its owner's to edit.

config BOOT_EXPECT_MODE
    string "Mode the command line check requires"
    depends on BOOT_ARGS_CHECK
    default "safe" if BOOT_MODE_SAFE
    default "recovery" if BOOT_MODE_RECOVERY
    default "normal"
    help
        Usually the default mode. Set it apart from BOOT_MODE together with
        BOOT_TEST_KEYS, to prove that a key chose an entry the default would
        not have.

config BOOT_TEST_KEYS
    string "Keys typed at the boot menu"
    depends on QEMU_EXIT
    default ""
    help
        Bytes `kbuild run` and `kbuild test --target` type on the guest's
        serial console as it starts, for proving the boot menu reads a
        keyboard. Only meaningful with a nonzero BOOT_MENU_TIMEOUT.

config CHAIN_TEST
    bool "Default to a chainload test entry"
    depends on QEMU_EXIT && BOOT_KINBOOT
    default n
    help
        Add a boot entry that chainloads a test payload instead of the
        kernel, and make it the default. The payload, which kbuild builds,
        passes the run only if it was started the way a chainloaded system
        expects: through LoadImage/StartImage with the loader's options on
        UEFI, and from its partition's boot record with the boot drive in DL
        on BIOS.

config BOOT_COUNTER_TEST
    bool "Fail normal boots on purpose, to prove the last-known-good counter"
    depends on QEMU_EXIT && KINBOOT_STUB
    default n
    help
        Every boot the EFI stub did not fall back to safe mode for fails on
        purpose and resets the machine through the firmware. The run passes
        only if the fallback comes on the attempt the limit promises, in safe
        mode, and that boot's confirmation reads back as cleared. `kbuild run`
        boots such an image without -no-reboot, so the boots are one machine
        whose variable store lives through the resets it counts. Replaces
        BOOT_ARGS_CHECK, whose mode would be wrong on the fallback boot.

config MOCK_ARCH
    bool
    default n
    help
        Compile the MockArch family in hal. These implement the capability
        traits in software so that subsystems can be tested on the host
        against several different hardware profiles. Never enabled in a
        kernel image; `kbuild test --host` turns it on.

        Deliberately without a prompt, so that neither menuconfig nor a
        generated configuration offers it. It had one, and the first
        random-configuration run found that 36 of 50 samples failed to build
        because of it: the mocks need `std`, and assume a 64-bit usize.

config INKERNEL_TESTS
    bool "In-kernel test suite"
    depends on QEMU_EXIT
    default n
    help
        Compile and run tests that must execute on the real architecture:
        atomics, interrupt masking, exception entry, and the frame allocator
        over the machine's actual memory map. Host tests against the mock
        architectures cover everything that does not need real hardware;
        this covers what is left.

        Requires a result channel, since the verdict is the guest's exit
        status rather than console output a harness would have to scrape.

config STACK_GUARD_TEST
    bool "Overflow the boot stack on purpose"
    # A guard that faults: an unmapped page on a paged kernel, or a locked
    # Physical Memory Protection region on a core with PMP and no MMU.
    depends on QEMU_EXIT && (MM_PAGED || ARCH_HAS_PMP)
    default n
    help
        After bring-up, recurse until the boot stack reaches its guard page,
        instead of running anything else. The run passes only if the fault
        that ends it is on the guard page: the exception path checks the
        faulting address and exits through the emulator's result channel.
        Any other fault, or none, is a failure.

        On a core with PMP and no MMU the guard is touched from a healthy
        stack rather than overflowed into, because a machine-mode trap runs
        on the stack it interrupts; see arch/riscv32/src/kspace.rs.

        A test mode, never a production setting. It exists because "the guard
        page is unmapped" is a property of a table, and "an overflow is caught
        and reported" is a property of the running machine. Only the second
        is worth having; see docs/testing.md.

config THREAD_STACK_GUARD_TEST
    bool "Overflow a kernel thread's stack on purpose"
    depends on QEMU_EXIT && (MM_PAGED || ARCH_HAS_PMP)
    default n
    help
        After bring-up, start a kernel thread on a stack from the guarded
        thread-stack array and recurse until it reaches that stack's guard
        page. The run passes only if the fault that ends it is on that guard:
        a boot-stack guard hit, or a thread stack quietly overflowing into
        the one below it, is a failure.

        A test mode, never a production setting; see STACK_GUARD_TEST.

config NULL_DEREF_TEST
    bool "Read through a null pointer on purpose"
    depends on QEMU_EXIT && MM_PAGED
    default n
    help
        After bring-up, read address zero. Page 0 is never mapped in the
        kernel's address space, so the read must fault, and the run passes
        only if the fault is reported as a null dereference.

        A test mode, never a production setting; see STACK_GUARD_TEST.

config STRESS_TEST
    bool "Run the stress workload after bring-up"
    depends on QEMU_EXIT && MM_PAGED
    select KALLOC_FAULT_INJECT
    default n
    help
        After a clean bring-up, hand the CPU to the scheduler and run mixed
        workloads for STRESS_SECONDS of guest time: heap churn under seeded
        fault injection, channel ping-pong moving handles, sleeps to random
        deadlines, demand paging with copy-on-write, and buddy page churn.
        An auditor thread stops the workloads at checkpoints every second,
        checks the books of each subsystem and that every workload made
        progress, and prints a heartbeat line `kbuild stress` watches. Any
        failed audit ends the run with a failure; the end of the time is a
        final audit and a success. See docs/testing.md.

        A test mode, never a production setting: it injects allocation
        failures into the kernel heap on purpose.

config STRESS_SECONDS
    int "Stress run length (seconds of guest time)"
    depends on STRESS_TEST
    range 1 604800
    default 60

config STRESS_SEED
    int "Stress run seed"
    depends on STRESS_TEST
    range 1 2147483647
    default 1
    help
        Seeds the heap's fault injector and every workload's random choices,
        so a failing run can be replayed with the same sequence of decisions.
        Thread interleaving still depends on timing, which no seed controls.

config MODULES
    bool "Loadable modules"
    depends on ARCH_X86_64 && MM_PAGED
    default y
    help
        Build the module loader into the kernel, and let a tristate be m:
        a unit of kind `module` enabled by it is built as a relocatable
        object for this kernel build alone, and loaded at run time. See
        docs/modules.md.

        x86-64 only for now. The loader's relocation code covers AArch64
        too, but an AArch64 module's calls into the kernel need veneers or
        a load address within 128 MiB of the image, and neither exists yet.

config MODULE_TEST
    tristate "Load, call and unload test modules at boot"
    depends on MODULES && QEMU_EXIT && m
    default m
    help
        Build the test modules under modules/test, pass them to the kernel
        in a module bundle, and gate the boot on the kernel loading one,
        calling through it, refusing to unload it while it is referenced,
        unloading it with every frame given back, and refusing the two that
        were built for another configuration and another interface.

        Capped at m by its dependency: these are modules or nothing.

# Crash on purpose once boot has finished, from a known nested function, so the
# crash report can be checked end to end: the kernel prints raw return addresses,
# and `kbuild symbolize` must name the function. A backtrace is only ever needed
# when something has already gone wrong, which is exactly when an untested one
# turns out not to work.
choice CRASH_TEST
    prompt "Deliberate crash after boot"
    default CRASH_NONE

    config CRASH_NONE
        bool "No deliberate crash"

    config CRASH_PANIC
        bool "Panic from a nested function"

    config CRASH_FAULT
        bool "Undefined instruction from a nested function"
endchoice

config FRAME_BITMAP_KIB
    int "Boot-time frame bitmap reserve (KiB)"
    range 1 4096
    default 32
    help
        Static reserve the boot path builds its frame allocator bitmap in.
        Two bits per frame of usable span, so 32 KiB covers about 512 MiB at
        a 4 KiB page, and 1 KiB covers 16 MiB — which is why the floor is 1:
        on a microcontroller the default is most of the RAM the image claims.
        A machine with more memory than this reports the shortfall and skips
        the report rather than truncating the pool.

        This is a bootstrap shortcut. The bitmap should be carved out of the
        memory it describes and this symbol should disappear; until then a
        preset that boots a large machine must raise it.

config QEMU_MEMORY_MB
    int "Guest memory under QEMU (MiB)"
    depends on QEMU_EXIT
    range 8 65536
    default 128

config QEMU_CPU
    string "CPU model under QEMU"
    depends on QEMU_EXIT
    default "max"
    help
        The i686 target deliberately runs on QEMU's default 32-bit CPU in
        its main preset, because it exists to serve legacy machines and
        testing it only on a modern core would defeat that. A second preset
        raises it, so both are covered.

config SIZE_BUDGET_KIB
    int "Kernel image size budget (KiB, 0 for none)"
    default 0
    help
        The most the linked kernel may occupy: every allocated section,
        .bss included, since that is what the machine must hold. `kbuild
        size` fails a build over it. A build setting rather than a kernel
        one, like QEMU_MEMORY_MB; the kernel never reads it.

        Set per preset, with headroom a real change can use and a
        regression cannot hide in. Deliberately unranged, so randomized
        configurations leave it alone. See docs/testing.md, "Size budgets".

config QEMU_CPUS
    int "CPUs under QEMU"
    depends on QEMU_EXIT
    range 1 255
    default 2 if ARCH_X86_64 || ARCH_I686
    default 1
    help
        The -smp count, and the CPU count the kernel requires firmware to
        describe: the MADT on x86, the device tree's /cpus on aarch64. So a
        run that silently lost its `-smp` cannot pass as an SMP test on one
        CPU. On aarch64 an SMP build starts every one of them. On x86 only
        the boot CPU runs today; two are described on the PC ports, so a MADT
        walk that stopped after its first entry cannot pass.

config QEMU_PCI_TEST_DEVICE
    bool "A PCI test device behind a bridge under QEMU"
    depends on QEMU_EXIT
    default y if ARCH_X86_64 || ARCH_I686
    help
        Add QEMU's pci-testdev behind a bridge: a PCI Express root port on
        q35, a PCI-to-PCI bridge on pc. Enumeration that does not follow
        bridges misses it, and its BARs have known sizes (256 bytes of I/O,
        4 KiB of memory), so the device check on x86 requires both to be
        found exactly. Also turns on the checks that only hold on QEMU's
        machines, such as the host bridge's identity.

config DRIVER_ISOLATION
    bool "Run a driver in an isolated domain"
    depends on USERSPACE && MM_PAGED && ARCH_AARCH64
    default y if ARCH_AARCH64
    help
        Phase 5's prototype: the same driver body -- `drivers/virtio-probe`,
        written against the `hwproxy` traits -- is run twice in one boot, once
        in the kernel over a window the kernel address space maps, and once
        inside an unprivileged domain over the same physical window mapped
        into an address space that holds nothing else. The two reports must
        agree, a domain that reaches past its grant must be killed without
        taking the kernel with it, and every frame must come back.

        aarch64 only, and that is a statement about the machines rather than
        about the design: the PCs have no memory-mapped device a domain could
        be granted today. Their serial port is in the port space, which is not
        mappable, and virtio-blk reaches them only over PCI, which is another
        fork's work. See docs/isolation.md.

config QEMU_BLOCK_TEST
    bool "A virtio-blk disk with a known pattern under QEMU"
    depends on QEMU_EXIT && MM_PAGED
    default y if ARCH_AARCH64 || ARCH_X86_64 || ARCH_I686
    help
        Attach a 6 MiB disk image kbuild writes at build time to a virtio-blk
        device, and gate the boot on the block check: the driver reads sectors
        whose contents are a function of their position, writes and reads
        back a scratch area, flushes, and must refuse a read past the end
        with no request or descriptor left outstanding. The image is attached
        with snapshot=on, so a run's writes never reach the file.

        The disk also holds a FAT16 volume, and the boot gates on the fs
        check too: it mounts the volume, reads files back through a block
        cache, and with USERSPACE loads and runs a program from it.

        On aarch64, where the device is a memory-mapped virtio slot the
        device tree describes. Needs MM_PAGED, because the check maps the
        driver's DMA region through the kernel's direct map.

        The same device over whichever transport the machine has: a
        memory-mapped virtio slot the device tree describes on aarch64, and a
        PCI function on the PCs. Which one a build gets is the difference the
        driver's `Transport` seam exists for, and the check is the same either
        way. Needs MM_PAGED, because the check maps the driver's DMA region
        through the kernel's direct map.

config SERIAL_IRQ_TEST
    bool "Prove the console UART receives on interrupt under QEMU"
    # The harness answers each prompt once per run, and a BOOT_COUNTER_TEST run is four
    # boots of one machine: from the second on, nobody would type.
    depends on QEMU_EXIT && !BOOT_COUNTER_TEST
    default y if ARCH_X86_64 || ARCH_I686 || ARCH_AARCH64
    help
        The boot prints a prompt, the harness types a known string on the
        serial console, and the console UART bound through the device model
        must receive every byte through its interrupt: the handler the
        device model's table holds must run for the line the controller
        routed, and no interrupt may reach no handler. On the PCs the
        driver is then unbound -- its handler unregistered, its ports and
        its line given back -- and bound again, and a second string must
        arrive the same way. Test builds only: nobody types at a production
        kernel's console on its way up.

config DEVICE_WINDOW_BASE
    hex
    default 0x0 if MOCK_ARCH
    default 0x10000000000 if MM_PAGED && (ARCH_X86_64 || ARCH_AARCH64)
    default 0x0
    help
        The virtual address at which physical device memory is visible: a
        register at physical address P is reached at DEVICE_WINDOW_BASE + P, on
        the boot tables and in the kernel's own address space alike. Every
        driver reaches its registers through `hal::paging::device_virt`, never
        at the physical address.

        1 TiB on x86_64 and aarch64, which is the end of their user half,
        `[512 GiB, 1 TiB)`. Device windows were once mapped at their physical
        address, and firmware put a PCI BAR at 768 GiB, inside that half: a
        top-level entry every process mirrors, so every process built its pages
        into one shared table. Above the user half no physical address can land
        there.

        Zero, meaning identity, on i686, which has no user half and no room in
        a 32-bit address space for a linear window over a 36-bit bus; on the
        ports without an MMU; and in host builds, which have no page tables.
