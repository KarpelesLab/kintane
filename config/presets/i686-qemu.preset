# i686 under QEMU's `pc` machine — the 32-bit x86 tier-1 configuration.
#
# This is the target that keeps PhysAddr honest: PAE gives 36-bit physical
# addresses behind a 32-bit pointer, so `PhysAddr` cannot be `usize` here.
# See docs/targets.md#i686.
ARCH_I686=y
SMP=n
EARLY_CONSOLE=y
DEBUG_BUILD=y
QEMU_EXIT=y
# QEMU's default 32-bit core, not `max`: this target exists for legacy machines.
QEMU_CPU="qemu32"
# 548 KiB when set. `kbuild size --preset i686-qemu` shows where it goes.
#
# 1028 rather than 1024: naming a disk whose line another device holds, and servicing that
# disk from the holder's handler, costs this image one page — 1,044,480 -> 1,048,576, which
# is exactly the old ceiling. 100% of budget boots (measured, not assumed), but it leaves
# nothing for the next byte. 1028 KiB is 1,052,672, so 4,096 spare again.
SIZE_BUDGET_KIB=1028
