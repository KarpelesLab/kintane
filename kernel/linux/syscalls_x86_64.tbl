# The x86_64 Linux system call table, in the format of Linux's own
# arch/x86/entry/syscalls/syscall_64.tbl: number, ABI, name, entry point.
#
# Not the whole table. It holds every call the personality implements and the calls a
# static program's start-up, or a common libc, is known to make, so an unimplemented one
# is logged by name rather than by number. A number missing from here is logged as
# unknown. The numbers are Linux's and never change; `kernel/linux`'s host tests pin every
# constant the kernel dispatches on to the name this file gives it.
#
# <number> <abi> <name> <entry point>
0	common	read			sys_read
1	common	write			sys_write
2	common	open			sys_open
3	common	close			sys_close
4	common	stat			sys_newstat
5	common	fstat			sys_newfstat
6	common	lstat			sys_newlstat
7	common	poll			sys_poll
8	common	lseek			sys_lseek
9	common	mmap			sys_mmap
10	common	mprotect		sys_mprotect
11	common	munmap			sys_munmap
12	common	brk			sys_brk
13	64	rt_sigaction		sys_rt_sigaction
14	common	rt_sigprocmask		sys_rt_sigprocmask
15	64	rt_sigreturn		sys_rt_sigreturn
16	64	ioctl			sys_ioctl
17	common	pread64			sys_pread64
18	common	pwrite64		sys_pwrite64
19	64	readv			sys_readv
20	64	writev			sys_writev
21	common	access			sys_access
22	common	pipe			sys_pipe
23	common	select			sys_select
24	common	sched_yield		sys_sched_yield
