# The aarch64 Linux system call table, in the format of Linux's own scripts/syscall.tbl,
# which the generic numbering in include/uapi/asm-generic/unistd.h is generated from:
# number, ABI, name, entry point.
#
# Not the whole table. It holds every call the personality implements and the calls a
# static program's start-up, or a common libc, is known to make, so an unimplemented one
# is logged by name rather than by number. aarch64 has no `open`, `pipe`, `fork` or
# `arch_prctl`: a C library reaches them as `openat`, `pipe2`, `clone` with SIGCHLD, and a
# write to TPIDR_EL0 from EL0. The numbers are Linux's and never change; `kernel/linux`'s
# host tests pin every number the kernel dispatches on to the name this file gives it.
#
# <number> <abi> <name> <entry point>
17	common	getcwd			sys_getcwd
23	common	dup			sys_dup
24	common	dup3			sys_dup3
25	common	fcntl			sys_fcntl
29	common	ioctl			sys_ioctl
34	common	mkdirat			sys_mkdirat
35	common	unlinkat		sys_unlinkat
46	common	ftruncate		sys_ftruncate
48	common	faccessat		sys_faccessat
49	common	chdir			sys_chdir
56	common	openat			sys_openat
57	common	close			sys_close
59	common	pipe2			sys_pipe2
